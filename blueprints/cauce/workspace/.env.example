# Variables de entorno de Cauce. Django NO lee este archivo por sí solo: en local todo funciona
# sin definir nada, y en Render se configuran en el panel del servicio (ver README.md).
# Si quieres cambiar algo en local, expórtalo en la terminal antes de correr manage.py.

# Obligatoria en Render. Cadena larga y aleatoria.
DJANGO_SECRET_KEY=
# 1 = modo desarrollo (por defecto en local), 0 = producción (por defecto en Render).
DJANGO_DEBUG=1
# 1 = mostrar el aviso "Datos de ejemplo" en todas las páginas.
CAUCE_DATOS_DEMO=1
